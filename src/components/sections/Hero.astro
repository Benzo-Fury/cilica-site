---
import Icon from "../Icon.astro";
import DownloadButton, { type Downloads } from "../../islands/DownloadButton.tsx";
import AppDemo from "../../islands/AppDemo.tsx";
import { repoUrl, type Release } from "../../lib/release";
interface Props { release: Release; downloads: Downloads }
const { release, downloads } = Astro.props;
---
<!-- Horizon: centred words on an empty sky; the ridges sit low, behind the app window. -->
<section class="hero" id="top" data-ridge-host>
  <canvas class="hero-sky" data-ridge-scene data-horizon-at=".hero-app" data-horizon-offset="150" aria-hidden="true"></canvas>
  <div class="wrap hero-in">
    <h1 class="t-hero hero-h">Notes that tidy themselves.</h1>
    <p class="t-lead hero-lead">Markdown notes with Cilica, an assistant that can find, sort and rewrite any of them. Calls are recorded without a bot and become notes too.</p>
    <div class="hero-act">
      <DownloadButton client:load downloads={downloads} />
      <a class="hero-link" href={repoUrl}>View the source<Icon name="ArrowUpRight" class="i-sm lift" /></a>
    </div>
    <p class="hero-note">Free and open source for Mac, Windows and Linux. <a href={release.pageUrl}>Version <span class="mono">{release.version}</span></a></p>
  </div>
  <div class="wrap hero-app">
    <AppDemo client:visible />
  </div>
</section>
