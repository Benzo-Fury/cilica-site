---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/sections/Hero.astro";
import Sidebar from "../components/sections/Sidebar.astro";
import Meetings from "../components/sections/Meetings.astro";
import Notes from "../components/sections/Notes.astro";
import Details from "../components/sections/Details.astro";
import Close from "../components/sections/Close.astro";
import { getRelease, downloadsFor } from "../lib/release";
import { SITE, webPage } from "../lib/schema";

const release = await getRelease();
const downloads = downloadsFor(release);
const title = "Cilica: private AI notes and meeting notes, on your computer";
const description = "A Markdown notes app with an assistant that can find, sort and rewrite any note, and meeting notes without a bot, transcribed on your computer. Free and open source for Mac, Windows and Linux.";
---
<Base title={title} description={description} schema={[webPage({ url: `${SITE}/`, name: title, description })]}>
  <Nav downloads={downloads} />
  <main>
    <Hero release={release} downloads={downloads} />
    <Sidebar />
    <Meetings />
    <Notes />
    <Details />
    <Close release={release} downloads={downloads} />
  </main>
</Base>
<script>
  import { startRidgelines } from "../scripts/ridgeline";
  import { startReveal } from "../scripts/reveal";
  startRidgelines();
  startReveal();
</script>
